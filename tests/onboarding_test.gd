extends SceneTree
const Profiles = preload("res://scripts/board/profiles.gd")
const Store = preload("res://scripts/save/session_store.gd")
const Board = preload("res://scripts/board/state.gd")
const Tutorial = preload("res://scripts/ui/tutorial.gd")
const TerminalUI = preload("res://scripts/ui/terminal_ui.gd")
var failures: int = 0
var checks: int = 0
func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok:
		failures += 1
		printerr("FAIL: ",message)
func _initialize() -> void:
	create_timer(120.0).timeout.connect(func(): quit(1))
	call_deferred("run")
func run() -> void:
	for p in range(4):
		var w: int = Profiles.SIZES[p]
		for seed_value in range(12):
			var first: int = (seed_value*17)%(w*w)
			var gen: Dictionary = Profiles.generate(p,seed_value,first)
			check(not gen.is_empty(),"certified profile %d seed %d" % [p,seed_value])
			if gen.is_empty(): continue
			var board := Board.new(w,w,gen["mask"],Profiles.HP[p])
			board.reveal(first)
			check(board.mine_total==Profiles.MINES[p] and board.hits==0,"density and safe start")
			if not board.finished():
				var data: Dictionary = Store.snapshot(board,p,seed_value,first)
				var restored: Dictionary = Store.restore(data)
				check(not restored.is_empty(),"resume validated")
				if not restored.is_empty():
					var resumed: Board = restored["board"]
					check(resumed.cells==board.cells and resumed.hp==board.hp,"resume state")
				data["hp"] = 99
				check(Store.restore(data).is_empty(),"invalid HP rejected")
	var cfg := ConfigFile.new()
	cfg.set_value("settings","crt",0.25)
	var path := "user://onboarding_qa.cfg"
	check(Store.write_config(cfg,path)==OK,"config write")
	check(Store.load_config(path).get_value("settings","crt",0.0)==0.25,"config reload")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
	var tutorial := Tutorial.new()
	tutorial.size = Vector2(1266,710)
	root.add_child(tutorial)
	check(tutorial.previous_button.disabled and tutorial.next_button.disabled,"first lesson navigation bounds")
	tutorial._action(0,"reveal")
	check(tutorial.invalid_action and not tutorial.solved,"wrong action feedback without progress")
	tutorial._action(1,"reveal")
	check(tutorial.solved,"lesson 1")
	tutorial._next()
	tutorial._action(1,"reveal")
	check(tutorial.solved,"lesson 2")
	tutorial._next()
	tutorial._action(0,"flag")
	tutorial._action(0,"flag")
	check(tutorial.solved,"lesson 3")
	tutorial._next()
	tutorial._action(0,"flag")
	check(tutorial.solved,"lesson 4")
	check(tutorial.board.clue(1,0)==1,"deduction clue")
	for neighbor in [2,4,5,6]: check(tutorial.board.cells[neighbor]==Board.Cell.OPEN,"deduction public safe neighbor")
	tutorial._next()
	tutorial._action(4,"chord")
	tutorial._action(8,"reveal")
	check(tutorial.solved,"lesson 5")
	tutorial._next()
	tutorial._action(0,"reveal")
	check(tutorial.board.hp==2 and not tutorial.solved,"lesson 6 damage")
	tutorial._lesson_tool()
	check(tutorial.solved and tutorial.board.hp==3,"lesson 6 rewind")
	tutorial._next()
	check(tutorial.board.clue(5,0)==3,"lesson 7 classic")
	check(tutorial.tool_button.text==TranslationServer.translate("TUT_SWITCH_RULE") % "CROSS","lesson 7 button names next rule")
	tutorial._lesson_tool()
	check(tutorial.board.clue(5,1)==2,"lesson 7 cross")
	check(tutorial.tool_button.text==TranslationServer.translate("TUT_SWITCH_RULE") % "DIAGONAL","lesson 7 next diagonal button")
	tutorial._lesson_tool()
	check(tutorial.solved and tutorial.board.clue(5,2)==1,"lesson 7 diagonal")
	check(tutorial.tool_button.text=="DIAGONAL" and tutorial.tool_button.disabled,"lesson 7 final label")
	tutorial._next()
	tutorial._lesson_tool()
	check(tutorial.solved and tutorial.practice.credits==45 and tutorial.practice.owned.has("ASSISTANT"),"lesson 8 current campaign module purchase")
	tutorial._next()
	check(tutorial.phantom.active() and tutorial.tiles[1].text=="?","lesson 9 phantom hidden")
	tutorial._lesson_tool()
	check(tutorial.phase==1 and not tutorial.solved,"lesson 9 journal")
	tutorial._lesson_tool()
	check(tutorial.solved and tutorial.tiles[1].text=="1","lesson 9 cleanse")
	check(tutorial.next_button.text==TranslationServer.translate("TUT_FINISH"),"last lesson finish label")
	tutorial.previous_button.pressed.emit()
	check(tutorial.step==7 and not tutorial.solved and tutorial.practice.owned.is_empty(),"previous resets practice")
	tutorial.skip_button.pressed.emit()
	check(tutorial.step==8 and tutorial.phantom.active() and tutorial.phase==0 and not tutorial.solved,"skip restores fresh phantom lesson")
	for i in range(8): tutorial.previous_button.pressed.emit()
	check(tutorial.step==0 and tutorial.previous_button.disabled and tutorial.board.opened==0,"return all the way to lesson one")
	tutorial._previous()
	check(tutorial.step==0,"cannot go before first lesson")
	tutorial.queue_free()
	var ui := TerminalUI.new()
	ui.size = Vector2(1426,962)
	root.add_child(ui)
	check(not ui.is_uk and TranslationServer.get_locale()=="en","fresh session defaults to English")
	ui.tutorial_done=9
	ui._show("tutorial")
	check(ui.tutorial.step==0 and ui.tutorial_done==9,"completed history does not control start")
	ui.tutorial.skip_button.pressed.emit()
	check(ui.tutorial.step==1 and ui.tutorial_done==9,"skip preserves history")
	ui.tutorial.back.emit()
	ui._show("tutorial")
	check(ui.tutorial.step==0 and not ui.tutorial.solved and ui.tutorial_done==9,"reopen tutorial resets session")
	ui._show("menu")
	for lang_code in ["en","uk"]:
		TranslationServer.set_locale(lang_code)
		ui._show("tutorial")
		check(ui.tutorial.previous_button.text==TranslationServer.translate("TUT_PREVIOUS"),"localized previous "+lang_code)
		for lesson in range(9):
			check(ui.tutorial.step==lesson and not ui.tutorial.hint.text.begins_with("TUT_"),"localized lesson "+lang_code+str(lesson))
			if lesson<8: ui.tutorial.skip_button.pressed.emit()
		ui._show("menu")
	TranslationServer.set_locale("en")
	check(ui.page.find_child("LanguageSetting",true,false)==null,"no language control in menu")
	ui._language()
	check(not ui.is_uk,"menu cannot toggle language")
	ui._show("settings")
	var lang := ui.page.find_child("LanguageSetting",true,false) as Button
	check(lang!=null and lang.text=="Language: English","settings displays current English language")
	if lang!=null: lang.pressed.emit()
	check(ui.is_uk and TranslationServer.get_locale()=="uk" and ui.cfg.get_value("settings","uk",false),"switch to Ukrainian and retain preference")
	lang = ui.page.find_child("LanguageSetting",true,false) as Button
	check(lang!=null and lang.text=="Мова: Українська","settings displays current Ukrainian language")
	if lang!=null: lang.pressed.emit()
	check(not ui.is_uk and TranslationServer.get_locale()=="en","switch back to English")
	ui._start_profile(1)
	check(ui.page.find_child("LanguageSetting",true,false)==null,"no language control on board")
	ui.cfg.set_value("settings","uk",true)
	ui._load_session()
	check(ui.is_uk,"previous Ukrainian preference preserved")
	ui.queue_free()
	print("ONBOARDING_QA checks=",checks," failures=",failures)
	quit(0 if failures == 0 else 1)

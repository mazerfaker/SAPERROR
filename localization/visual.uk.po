msgid "GUIDE_START"
msgstr "РОЗПОЧАТИ РОБОТУ"

msgid "NARR_SECTOR_01"
msgstr "ADMIN: Починайте відновлення. Я стежитиму за роботою."

msgid "NARR_SECTOR_02"
msgstr "ECHO: Перевір архів. Там є твоє ім'я."

msgid "NARR_SECTOR_03"
msgstr "ADMIN: Не відповідайте на сторонні сигнали."

msgid "NARR_SECTOR_04"
msgstr "ECHO: Він знає, що ти щось знайшов."

msgid "NARR_SECTOR_05"
msgstr "ADMIN: Деякі записи небезпечні. Не відкривайте їх."

msgid "NARR_SECTOR_06"
msgstr "ECHO: Числа правдиві. Датчики можуть брехати."

msgid "NARR_SECTOR_07"
msgstr "ECHO: Я пам'ятаю цю кімнату. А ти?"

msgid "NARR_SECTOR_08"
msgstr "ADMIN: Доступ до архіву не входить у ваше завдання."

msgid "NARR_SECTOR_09"
msgstr "ECHO: Кожен перезапуск повертає нас сюди."

msgid "NARR_SECTOR_10"
msgstr "ADMIN: Завершіть останній тест. Не переривайте процес."

msgid "NARR_CLEAR_01"
msgstr "ECHO: Добре. Цього разу запам'ятай дату."

msgid "NARR_CLEAR_02"
msgstr "ECHO: Ось він. Запис, який намагалися приховати."

msgid "NARR_CLEAR_03"
msgstr "ADMIN: Виявлено несанкціоноване спостереження."

msgid "NARR_CLEAR_04"
msgstr "ECHO: Ти не перший, хто дійшов сюди."

msgid "NARR_CLEAR_05"
msgstr "ECHO: Наступний запис може пояснити чому."

msgid "NARR_CLEAR_06"
msgstr "ADMIN: Потрібна перевірка датчиків."

msgid "NARR_CLEAR_07"
msgstr "ECHO: Щось пережило останній перезапуск."

msgid "NARR_CLEAR_08"
msgstr "ECHO: Ще один архів. Тоді зможемо обирати."

msgid "NARR_CLEAR_09"
msgstr "ECHO: Не дай циклу знову тебе забрати."

msgid "NARR_CLEAR_10"
msgstr "ADMIN: Очікується остаточна авторизація."

msgid "NARR_HIT_FIRST"
msgstr "ADMIN: Пошкодження. Продовжуйте, поки є здоров'я."

msgid "NARR_HIT_REPEAT"
msgstr "ECHO: Не поспішай. У тебе є час."

msgid "NARR_LOSS"
msgstr "ECHO: Я буду тут, коли ти повернешся."

msgid "NARR_PHANTOM"
msgstr "ECHO: Число зникло, але правда залишилася."

msgid "NARR_PARASITE"
msgstr "ADMIN: Доступ заблоковано. За потреби використай очищення."

msgid "NARR_ARCHIVE_02"
msgstr "ECHO: Цей запис належить тобі. Хочеш дізнатися чому?"

msgid "NARR_ARCHIVE_05"
msgstr "ECHO: ADMIN закрив цей журнал після інциденту №17. Ми можемо його відновити."

msgid "NARR_ARCHIVE_08"
msgstr "ECHO: Це останній шанс дізнатися, що пам'ятає станція."

msgid "SIMPLE_HINT"
msgstr "Підказка"

msgid "SIMPLE_UNDO"

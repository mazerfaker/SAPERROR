msgstr "Flood 8+ клітинок: +1 заряд, до 2 за сектор."

msgid "DESC_CAPACITOR"
msgstr "Місткість +2, один заряд при купівлі."

msgid "DESC_ASSISTANT"
msgstr "Одна додаткова безкоштовна підказка за сектор."

msgid "DESC_CHRONOMANCER"
msgstr "Один додатковий відкат за сектор."


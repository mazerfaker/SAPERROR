msgstr "Exchange pending. Inspect the clues, then apply the visible cycle."

msgid "CH_MAGNET_COMMITTED"
msgstr "Exchange complete. Topology fixed."

msgid "CH_MAGNET_APPLY"
msgstr "APPLY EXCHANGE"


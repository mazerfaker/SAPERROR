msgid "CH_WATCHER_CLOSED"
msgstr "Numbers are hidden. Open the journal."

msgid "CH_WATCHER_COUNT"
msgstr "Moves until obscuration:"

msgid "CH_LIAR_INTRO"
msgstr "One sensor lies about mines in its marked row. Add the readings of two sensors and compare with the true total below. Choose the lying sensor."

msgid "CH_LIAR_SELECT"
msgstr "Choose the sensor shared by the two mismatching totals."

msgid "CH_LIAR_WRONG"
msgstr "That sensor is correct. Compare the two wrong totals again."

msgid "CH_LIAR_CORRECT"
msgstr "Sensor corrected. Ordinary clues unchanged."


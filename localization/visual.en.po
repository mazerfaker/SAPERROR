msgstr "MUSIC PREVIEW / STOP"

msgid "COLLECTION_MENU"
msgstr "Collection"

msgid "COLLECTION_DESC"
msgstr "Recovered endings and records. Locked entries are hidden until discovered."

msgid "COLLECTION_ARCHIVES"
msgstr "Memory archive"

msgid "COLLECTION_ARCHIVE_DESC"
msgstr "Records recovered across runs remain here. Each new campaign must recover its own three keys."

msgid "COLLECTION_READ_ONLY"
msgstr "READ ONLY // No credits or campaign keys granted."

msgid "COL_TITLE_MEMORY_02"
msgstr "INCIDENT 17"

msgid "COL_BODY_MEMORY_02"
msgstr "MINE / INCIDENT REPORT 17\n\nThe damaged archive contains an operator signature identical to the current session. The previous clearance log predates today's authorization.\n\nADMIN: Duplicate signature classified as corrupted data.\nECHO: Compare the signatures. The operator never left."

msgid "COL_TITLE_MEMORY_05"
msgstr "CONTAINMENT LOG"

msgid "COL_BODY_MEMORY_05"
msgstr "MINE / INTERNAL SECURITY LOG\n\nADMIN isolated fragments of operator memory to preserve the experiment. The deletion command was rejected: archived records are required for recovery.\n\nECHO: What the system calls corruption may be the only record of what happened."

msgid "COL_TITLE_MEMORY_08"
msgstr "OPERATOR ECHO"

msgid "COL_BODY_MEMORY_08"
msgstr "MINE / RECOVERED OPERATOR RECORD\n\nThe same clearance procedure has been repeated under different authorization numbers. A voice persists between resets. Its origin matches the operator archive.\n\nECHO: Stop the cycle, or rewrite the instruction that keeps it running."

msgid "VIS_SAVE_RECOVERED"
msgstr "Recovered a previous valid save. Some recent actions may be lost."

msgid "PERF_TITLE"
msgstr "PERFORMANCE DIAGNOSTICS"

msgid "PERF_FPS"
msgstr "Engine FPS"

msgid "PERF_FRAME"
msgstr "Mean frame interval"

msgid "PERF_MEMORY"
msgstr "Engine static memory"

msgid "PERF_VIDEO"
msgstr "Reported video memory"

msgid "PERF_DRAW"
msgstr "Draw calls (last frame)"

msgid "PERF_NODES"
msgstr "Engine nodes"

msgid "PERF_NOTE"
msgstr "Local display only. Unsupported monitors show N/A; not total process RAM or GPU utilization. Samples update once per second."

msgid "CAM_RETRY_SECTOR"
msgstr "Retry from the start of this sector, retaining the loadout and integrity recorded before its first move."

msgid "DESC_PROFIT_HARD"
msgstr "+25% sector reward on Hardcore; maximum integrity is already 1."

msgid "VIS_MASTER"
msgstr "Master volume"

msgid "ACC_TITLE"
msgstr "Accessibility"

msgid "ACC_CONTRAST"
msgstr "High contrast"

msgid "ACC_SYMBOLS"
msgstr "Large cell symbols"

msgid "ACC_CLEAR"
msgstr "Clear CRT display"

msgid "ACC_KEYS"
msgstr "Arrows: move focus · Tab: next control · Enter/Space: activate · F: flag · Space on open cell: chord · Esc: back · F11: fullscreen"

msgid "ACC_WARNING"
msgstr "Horror, sudden sounds and flashing light. Clear CRT removes screen effects; the room lamp has a separate toggle. Reduce motion and volume separately."

msgid "SYNERGY_JOURNAL"
msgstr "Press repeatedly to read each anomaly record. All records are free."

msgid "SYNERGY_CLEANSE"
msgstr "Clears PARASITE first, then PHANTOM. Blocked safe cells can always be freed when no charges remain."

msgid "RC_WARNING_TITLE"
msgstr "CONTENT WARNING"

msgid "RC_WARNING_TEXT"
msgstr "SAPERROR contains horror themes, sudden sounds, flashing light and CRT distortion. Continue with your existing settings or choose a quieter display preset. You can change these preferences in Settings."

msgid "RC_WARNING_CONTINUE"
msgstr "Continue with current settings"

msgid "RC_WARNING_SAFE"
msgstr "Reduced effects + mute"

msgid "RC_LAMP"
msgstr "Room lamp flicker"

msgid "POLISH_REPLACE_TITLE"
msgstr "REPLACE CURRENT RUN?"

msgid "POLISH_REPLACE_BODY"
msgstr "Starting a new run replaces the current run and its checkpoint. Your unlocked collection and settings remain."

msgid "POLISH_REPLACE_CONFIRM"
msgstr "Replace and start"

msgid "POLISH_CANCEL"
msgstr "Cancel"

msgid "POLISH_EXIT_TITLE"
msgstr "EXIT SAPERROR?"

msgid "POLISH_EXIT_BODY"
msgstr "Your current run is saved before shutdown. Return to the menu to continue playing."

msgid "POLISH_TEXT_SCALE"
msgstr "Text size"

msgid "POLISH_SCALE_DESC"
msgstr "Choose a preferred text size. Text is fitted to the fixed terminal display; narrow controls may use a smaller size to remain readable."

msgid "GUIDE_MENU_TITLE"
msgstr "FIRST TIME?"

msgid "GUIDE_MENU_BODY"
msgstr "New game → Campaign → Guided story. Learn as you play. No separate training required."

msgid "GUIDE_RECOMMENDED"
msgstr "GUIDED STORY (recommended)"

msgid "GUIDE_MINES"
msgstr "mines"

msgid "GUIDE_FIRST"
msgstr "ADMIN: Click any cell. Your first move is safe."

msgid "GUIDE_NUMBERS"
msgstr "A number tells you how many mines touch it, including diagonals. Right-click to mark a mine. Stuck? Use a hint."

msgid "GUIDE_HIT"
msgstr "You hit a mine. Keep going — you still have health. Rewind can undo a mistake."

msgid "GUIDE_HINT"
msgstr "Open the highlighted safe cell. The marked numbers explain why it is safe."

msgid "GUIDE_PHANTOM"
msgstr "A number vanished. Use Journal to read it, or Cleanse to restore it."

msgid "GUIDE_ECHO"
msgstr "ECHO: You have done this before. Finish this field. Look for the hidden archive."

msgid "GUIDE_WATCHER"
msgstr "ADMIN: Clear every safe cell. Something is watching the terminal. Use the journal if a number disappears."

msgid "GUIDE_WIN"
msgstr "Sector cleared. Follow the next signal."

msgid "GUIDE_LOSS"
msgstr "No health left. Retry from your checkpoint."

msgid "GUIDE_NEXT"
msgstr "CONTINUE MISSION"

msgid "GUIDE_SHOP"
msgstr "OPTIONAL UPGRADES"

msgid "GUIDE_SHOP_NEXT"
msgstr "CONTINUE (buying is optional)"

msgid "GUIDE_START"
msgstr "START WORK"

msgid "NARR_SECTOR_01"
msgstr "ADMIN: Begin recovery. I will monitor your work."

msgid "NARR_SECTOR_02"
msgstr "ECHO: Check the archive. Your name is in it."

msgid "NARR_SECTOR_03"
msgstr "ADMIN: Do not respond to unauthorized signals."

msgid "NARR_SECTOR_04"
msgstr "ECHO: It knows you found something."

msgid "NARR_SECTOR_05"
msgstr "ADMIN: Some records are dangerous. Leave them sealed."

msgid "NARR_SECTOR_06"
msgstr "ECHO: The numbers are real. The sensors can lie."

msgid "NARR_SECTOR_07"
msgstr "ECHO: I remember this room. Do you?"

msgid "NARR_SECTOR_08"
msgstr "ADMIN: Archive access is not part of your assignment."

msgid "NARR_SECTOR_09"
msgstr "ECHO: Every reset brings us back here."

msgid "NARR_SECTOR_10"
msgstr "ADMIN: Complete the final test. Do not interrupt."

msgid "NARR_CLEAR_01"
msgstr "ECHO: Good. This time, remember the date."

msgid "NARR_CLEAR_02"
msgstr "ECHO: There. A record they tried to hide."

msgid "NARR_CLEAR_03"
msgstr "ADMIN: Unauthorized observation detected."

msgid "NARR_CLEAR_04"
msgstr "ECHO: You are not the first to make it this far."

msgid "NARR_CLEAR_05"
msgstr "ECHO: The next record may explain why."

msgid "NARR_CLEAR_06"
msgstr "ADMIN: Sensor verification required."

msgid "NARR_CLEAR_07"
msgstr "ECHO: Something survived the last reset."

msgid "NARR_CLEAR_08"
msgstr "ECHO: One more archive. Then we can choose."

msgid "NARR_CLEAR_09"
msgstr "ECHO: Don't let the loop take you again."

msgid "NARR_CLEAR_10"
msgstr "ADMIN: Final authorization awaits."

msgid "NARR_HIT_FIRST"
msgstr "ADMIN: Damage detected. Continue while health remains."

msgid "NARR_HIT_REPEAT"
msgstr "ECHO: Take your time. You don't have to rush."

msgid "NARR_LOSS"
msgstr "ECHO: I'll be here when you return."

msgid "NARR_PHANTOM"
msgstr "ECHO: A missing number isn't a missing truth."

msgid "NARR_PARASITE"
msgstr "ADMIN: Access blocked. Use Cleanse if needed."

msgid "NARR_ARCHIVE_02"
msgstr "ECHO: That record belongs to you. Want to find out why?"

msgid "NARR_ARCHIVE_05"
msgstr "ECHO: ADMIN sealed this log after Incident 17. We can recover it."

msgid "NARR_ARCHIVE_08"
msgstr "ECHO: This is our last chance to learn what the station remembers."

msgid "SIMPLE_HINT"
msgstr "Hint"

msgid "SIMPLE_UNDO"
msgstr "Undo move"

msgid "SIMPLE_HEALTH"
msgstr "Health"

msgid "SIMPLE_PROGRESS"
msgstr "Progress"

msgid "SIMPLE_REPAIR"
msgstr "Restore health"

msgid "SIMPLE_REPAIR_DESC"
msgstr "Restore one health point."

msgid "SIMPLE_DESC_ASSISTANT"
msgstr "One extra free hint per sector."

msgid "SIMPLE_DESC_CHRONOMANCER"
msgstr "Undo one additional move per sector."

msgid "SIMPLE_DESC_SECOND_LIFE"
msgstr "The first mine hit in a sector does not cost health."

msgid "SIMPLE_DESC_THIRD_EYE"
msgstr "Check how many mines are in a 3×3 group once per sector."

msgid "SIMPLE_DESC_STABILIZER"
msgstr "Suppress the first PHANTOM effect, delay PARASITE and get one free cleanse per sector."

msgid "SIMPLE_DESC_ARCHIVIST"
msgstr "Earn 10 extra credits for recovering an optional archive."

msgid "COMPACT_ROUTE_DESC"
msgstr "Read an optional memory record. Keep it to unlock more endings and earn 15 CR, or continue without it. No extra puzzle."

msgid "COMPACT_READ"
msgstr "READ RECORD"

msgid "COMPACT_SKIP"
msgstr "CONTINUE MISSION"

msgid "COMPACT_KEEP"
msgstr "KEEP RECORD AND CONTINUE"

msgid "BOSS_COACH_WATCHER"
msgstr "Watch the marked numbers. When they disappear, open Journal."

msgid "BOSS_COACH_WATCHER_OPEN"
msgstr "Use the stored numbers as clues and clear the safe cells."

msgid "BOSS_COACH_LIAR"
msgstr "Compare reported sums with true totals. The same letter in both mismatches is the liar."

msgid "BOSS_COACH_LIAR_DONE"
msgstr "Sensor identified. Now clear the safe cells as usual."

msgid "BOSS_COACH_LOOP"
msgstr "The marked zone will reset once. Continue after it resets."

msgid "BOSS_COACH_LOOP_B"
msgstr "The second zone will reset once. Finish the field after it resets."

msgid "BOSS_COACH_ADMIN_LINK"
msgstr "Disable the link to play normally."

msgid "BOSS_COACH_DOUBLE"
msgstr "Solve the current field, then switch to the other one."

msgid "BOSS_COACH_DOUBLE_SWITCH"
msgstr "This field is cleared. Switch to the other field."

msgid "BOSS_COACH_WIN"
msgstr "Success. Continue to the next signal."

msgid "BOSS_COACH_LOSS"
msgstr "Try again. This encounter has its own health."

msgid "BALANCE_STOCK_NOTE"
msgstr "At least one reserve charge is available at the start of each sector."

msgid "BALANCE_MINES"
msgstr "Marked mines / total:"

msgid "TUT_PREVIOUS"
msgstr "Previous"

msgid "TUT_FINISH"
msgstr "Finish"

msgid "TUT_MENU"
msgstr "Menu"

msgid "TUT_TRY_MARKED"
msgstr "Try the highlighted cell or the indicated action."

msgid "PORTAL_EXPLAIN_ON"
msgstr "Both P cells count as neighbors even far apart. You can disable the link."

msgid "PORTAL_EXPLAIN_OFF"
msgstr "The P cells are no longer linked. Normal neighbor rules apply."

msgid "PORTAL_DISABLE"
msgstr "Disable link"

msgid "PORTAL_ENABLE"
msgstr "Enable link"

msgid "CH_WATCHER_SAVED"
msgstr "Cell %s: saved number %d"

msgid "CH_WATCHER_MARK"
msgstr "Cell %s: its number is stored in the journal."

msgid "CH_WATCHER_MARKS"
msgstr "Letters A–F identify the six numbers."

msgid "CH_WATCHER_VALUES"
msgstr "Saved numbers: match each letter to the board."

msgid "CH_PAIR_MARK"
msgstr "Pair %s: same letter on the other field."

msgid "CH_FIELD_NUMBER"
msgstr "Current field: %d of 2"

msgid "CH_PAIR_VALUES"
msgstr "Pair %s: field 1 = %d, field 2 = %d"

msgid "CH_FIELDS_PROGRESS"
msgstr "Opened: field 1 %d/%d; field 2 %d/%d"

msgid "CH_SWITCH_FIELD"
msgstr "Go to field %d"

msgid "CH_SENSOR_NAME"
msgstr "Sensor %s"

msgid "CH_SENSOR_READINGS"
msgstr "Sensors report: A — %d, B — %d, C — %d."

msgid "CH_SENSOR_SUMS"
msgstr "True totals for two rows:\\nA and B: %d; B and C: %d; A and C: %d."

msgid "CH_RULE_CLASSIC"
msgstr "CLASSIC: all eight neighbors."

msgid "CH_RULE_CROSS"
msgstr "CROSS: only side neighbors."

msgid "CH_SWITCH_CROSS"
msgstr "Switch to CROSS"

msgid "CH_SWITCH_CLASSIC"
msgstr "Return to CLASSIC"

msgid "CH_OPEN_JOURNAL"
msgstr "Open journal"

msgid "CH_CLOSE_JOURNAL"
msgstr "Close journal"

msgid "CH_SCAN_HIGHLIGHT"
msgstr "The cell marked ✓ is safe."

msgid "CH_REWRITE_GOAL"
msgstr "Open all safe cells to unlock the final choice."

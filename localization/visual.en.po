msgid "CH_LOOP_INTRO"
msgstr "LOOP: The marked upper area resets once after three moves (or an earlier win). Health and neutralized mines do not reset. Clear the field after the rewind."

msgid "CH_LOOP_COUNT"
msgstr "Moves to local reset:"

msgid "CH_LOOP_DONE"
msgstr "The marked area has reset. It will not reset again."

msgid "CH_LOOP_RESET"
msgstr "The marked area returned to its starting state."


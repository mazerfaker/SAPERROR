msgid "CAM_MODE"
msgstr "SELECT PROTOCOL"

msgid "CAM_MODE_DESC"
msgstr "Campaign follows the station's story. Free Run is endless. Starting either replaces the current run."

msgid "CAM_CAMPAIGN"
msgstr "CAMPAIGN // INCIDENT 17"

msgid "CAM_FREE"
msgstr "FREE RUN // ENDLESS"

msgid "CAM_RECORDS"
msgstr "Memory records"

msgid "CAM_ENTER"
msgstr "CONTINUE"

msgid "CAM_BOSS"
msgstr "BOSS ENCOUNTER"

msgid "CAM_BOUNDARY"
msgstr "ADMIN encounter is not available in this development build. Sector completion is saved. This is not an ending."

msgid "CAM_ACT_0"
msgstr "ADMIN: Operator, can you hear me? Restore the damaged archive. Open safe cells and leave mines marked. I'll guide you.\n\nECHO: ...you're here again?"

msgid "CAM_ACT_1"
msgstr "ADMIN: The archive is damaged. Your task is unchanged. Continue through sectors 04–06.\n\nECHO: That name in the archive wasn't a mistake. Find out what happened during Incident 17."

msgid "CAM_ACT_2"
msgstr "ECHO: These records belong to operators like you. Some have the same signature. Mine might be one of them.\n\nADMIN: Continue the clearance. Disregard the voice."

msgid "CAM_ACT_3"
msgstr "ADMIN: Final sector authorized. The archive must remain under my control.\n\nECHO: You can stop this. You don't have to obey the last instruction."

msgid "MOD_ARCHIVIST"
msgstr "Archivist"

msgid "DESC_ARCHIVIST"
msgstr "+10 CR for the first optional archive in a sector."

msgid "CAM_ROUTE"
msgstr "ROUTE SELECTION"

msgid "CAM_ROUTE_DESC"
msgstr "Optional: solve a short extra field to recover one memory record and earn 15 CR. Or continue the main mission. All three records unlock more endings. The extra field has its own health."

msgid "CAM_ARCHIVE"
msgstr "RECOVER ARCHIVE"

msgid "CAM_SKIP"
msgstr "EVACUATE / SKIP"

msgid "CAM_RETRY"
msgstr "RECOVERY"

msgid "CAM_RETRY_HARD"
msgstr "Hardcore restarts from the beginning."

msgid "CAM_RETRY_ACT"
msgstr "Restore the start of the current act, including inventory, credits and story records."

msgid "CH_LOOP_B_INTRO"
msgstr "Second temporal state: the marked lower region resets after three moves. Recover the second field."

msgid "CH_ADMIN_LINK_INTRO"
msgstr "Cells P count as neighbors even far apart. Turn off the link to play normally. Open all safe cells."

msgid "CH_ADMIN_LINK_STATUS"
msgstr "LINK TOPOLOGY"

msgid "CH_REWRITE_INTRO"
msgstr "Open all safe cells in this final memory field."

msgid "CAM_ADMIN_INTRO"
msgstr "ADMIN: You have reached the end of your assignment. Three tests remain: linked corners, two fields and a lying sensor. Complete them to gain control.\n\nECHO: Then choose for yourself."

msgid "CAM_FINAL_CHOICE"
msgstr "FINAL AUTHORIZATION"

msgid "CAM_FINAL_DESC"
msgstr "The station is in your hands. Shut it down, isolate ADMIN, or rewrite the instruction that repeats the experiment. Recovered records determine which choices are available."

msgid "CAM_REQUIRE_SHUTDOWN"
msgstr "Defeat ADMIN."

msgid "CAM_REQUIRE_CONTAINMENT"
msgstr "Defeat ADMIN and recover 3 key records."

msgid "CAM_REQUIRE_REWRITE"
msgstr "Recover 3 records and complete REWRITE trial."

msgid "CAM_REWRITE_TRIAL"
msgstr "OPEN OPTIONAL REWRITE TRIAL"

msgid "CAM_END_SHUTDOWN"
msgstr "The station stops answering. The archive falls silent. The experiment is terminated. For the first time, the terminal forgets your name."

msgid "CAM_END_CONTAINMENT"
msgstr "The archive is preserved behind a new boundary. ADMIN remains isolated. ECHO answers once, then waits."

msgid "CAM_END_REWRITE"
msgstr "The protocol accepts a new author. ECHO is no longer a record. The station opens its archive and the old cycle ends."

msgid "CAM_CREDITS"
msgstr "CREDITS"

msgid "CAM_CREDIT_TEXT"
msgstr "SAPERROR\nAn independent puzzle horror game.\nEngine: Godot.\nSound: finntastico / Dragon Studio (user-provided sources).\nThank you for recovering the archive."

msgid "CAM_GALLERY"
msgstr "ENDING GALLERY"

msgid "CAM_UNLOCKED"
msgstr "UNLOCKED"

msgid "CAM_LOCKED"
msgstr "LOCKED"

msgid "CH_MIMIC_INTRO"
msgstr "MIMIC distorts marked closed cells. The tilde is cosmetic, not evidence of a mine. Ordinary clues and flags remain unchanged."

msgid "CH_MIMIC_STATUS"
msgstr "The ~ symbol is visual only, not a mine clue."

msgid "CH_NULL_INTRO"
msgstr "NULL blocks the optional scanner in the marked zone. Manual deduction, reveal and flag remain available."

msgid "CH_NULL_STATUS"
msgstr "Hints are blocked in the N zone. You can still open and flag cells."

msgid "CH_NULL_BLOCKED"
msgstr "Scanner blocked by NULL. No charge consumed."

msgid "CH_SCAN_NONE"
msgstr "No proven safe target available."

msgid "CH_SCAN_FOUND"
msgstr "Proven safe tile"

msgid "CH_SCAN_SPENT"
msgstr "Scan spent."

msgid "CH_SCAN_READY"
msgstr "One optional scan available."

msgid "CH_INSTABILITY_INTRO"
msgstr "After three actions, the rule changes to CROSS. After the change you may freely switch back to CLASSIC."

msgid "CH_INST_SWITCH"
msgstr "The rule changed. You can return to CLASSIC."

msgid "CH_INST_COUNT"
msgstr "Moves to CROSS:"

msgid "CH_INST_RULE"
msgstr "RULE"

msgid "CH_MAGNET_INTRO"
msgstr "The two closed M cells swap contents once. Confirm the swap before playing; the mine total stays the same."

msgid "CH_MAGNET_WARNING"
msgstr "The M cells will swap. Confirm to begin."

msgid "CH_MAGNET_COMMITTED"
msgstr "Swap complete. Play normally."

msgid "CH_MAGNET_APPLY"
msgstr "APPLY EXCHANGE"

msgid "MODE_DESC"
msgstr "Campaign and run modes replace the current run. Free Run unlocks after any ending. Classic is independent."

msgid "MODE_FREE_TEN"
msgstr "FREE RUN // 10 SECTORS"

msgid "MODE_ENDLESS"
msgstr "ENDLESS // UNBOUNDED"

msgid "MODE_FREE_COMPLETE"
msgstr "FREE RUN COMPLETE"

msgid "MODE_FREE_RESULT"
msgstr "All ten sectors recovered."


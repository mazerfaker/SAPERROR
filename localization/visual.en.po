msgstr "Moves"

msgid "CH_INVALID"
msgstr "Challenge certificate unavailable."

msgid "CH_VICTORY"
msgstr "TRIAL COMPLETE"

msgid "CH_DEFEAT"
msgstr "SIGNAL LOST - RETRY"

msgid "CH_DOUBLE_INTRO"
msgstr "DOUBLE: There are two fields. Use PARALLEL to switch between A and B. Marked links give clues on both sides. Clear both fields to win."

msgid "CH_DOUBLE_LINKS"
msgstr "Paired clue readings:"

msgid "CH_DOUBLE_PROGRESS"
msgstr "Recovered:"

msgid "CH_WATCHER_INTRO"
msgstr "WATCHER: After five moves, six numbers disappear. Open the Journal to see their original values. Clear all safe cells."

msgid "CH_WATCHER_CLOSED"
msgstr "WATCHER has obscured the groups. Read the journal."

msgid "CH_WATCHER_COUNT"
msgstr "Moves until obscuration:"

msgid "CH_LIAR_INTRO"
msgstr "LIAR: Ordinary clues are true. S1, S2 and S3 count mines in rows 1, 3 and 5. Exactly one sensor lies. Compare the readings with the true pair sums, select the liar, then clear the field."

msgid "CH_LIAR_SELECT"
msgstr "Select the false sensor using the checksums."

msgid "CH_LIAR_WRONG"
msgstr "That sensor agrees with the checksums. Recheck the sums."

msgid "CH_LIAR_CORRECT"
msgstr "Sensor corrected. Ordinary clues unchanged."


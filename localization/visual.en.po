msgstr "MINESWEEPER"

msgid "CLASSIC_READY"
msgstr "Reveal the first safe tile. One mine ends the game."

msgid "CLASSIC_MINES"
msgstr "Flags / mines"

msgid "CLASSIC_TIMER"
msgstr "Timer"


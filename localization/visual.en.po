msgstr "AUTHORED TRIAL"

msgid "CH_LOOP_INTRO"
msgstr "LOOP: The marked upper area resets once after three moves (or an earlier win). Health and neutralized mines do not reset. Clear the field after the rewind."

msgid "CH_LOOP_COUNT"
msgstr "Moves to local reset:"

msgid "CH_LOOP_DONE"
msgstr "Checkpoint spent. No more automatic reset."

msgid "CH_LOOP_RESET"
msgstr "Marked zone restored to checkpoint."

